// The light table (LightTable; vertex_lens_core.glsl, prepended, reads it as RelativityLightTable): one invocation per
// view direction of its grid, the light marched the whole way through the superposed field (physics-core's OrbitField:
// each hole's photon orbit, -3/2 r_s h^2 x / r^5, h = |x × v|; each mass twice its Newtonian pull across the light), RK4
// at a fifth of the distance to the nearest source, recording where it first crosses each sphere round the camera and
// its heading there, then where it ends heading (or that a hole captured it: inside a photon sphere heading in).
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba32f, binding = 0) uniform writeonly image2DArray Table;
layout(r32ui, binding = 2) uniform uimage2D Counts; // crossings per signature (256 x 1), cleared before the pass

// Each ray's own place, as the table's or (LIGHT_TABLE_DETAIL: LightTable's detail pass) the detail atlas's: the same
// march either way, a ray at a table position (texel units) stored at its own texel. In detail, the atlas is slots of
// RELATIVITY_TABLE_STRIDE rays a side, each a block of the table's rays RELATIVITY_TABLE_FINE times as finely with
// RELATIVITY_TABLE_APRON rays round (TileSlots: slot s's block at (s, 0), x | y << 16; -1 unused).
#ifdef LIGHT_TABLE_DETAIL
layout(rgba32f, binding = 3) uniform writeonly image2DArray Detail;
layout(r32i, binding = 4) uniform readonly iimage2D TileSlots;

int relativityRaySlot(ivec2 texel) {
    ivec2 s = texel / RELATIVITY_TABLE_STRIDE;
    if (s.x >= RELATIVITY_TABLE_SLOTS_X) return -1;
    int slot = s.x + s.y * RELATIVITY_TABLE_SLOTS_X;
    if (slot >= RELATIVITY_TABLE_DETAIL_SLOTS || imageLoad(TileSlots, ivec2(slot, 0)).r < 0) return -1;
    return slot;
}

vec2 relativityRayUv(ivec2 texel) {
    int slot = relativityRaySlot(texel);
    int block = imageLoad(TileSlots, ivec2(slot, 0)).r;
    ivec2 tile = ivec2(block & 65535, block >> 16);
    ivec2 local = texel - (texel / RELATIVITY_TABLE_STRIDE) * RELATIVITY_TABLE_STRIDE;
    return vec2(tile * RELATIVITY_TABLE_TILE) + (vec2(local - RELATIVITY_TABLE_APRON) + 0.5) / float(RELATIVITY_TABLE_FINE);
}

void relativityStore(ivec2 texel, int layer, vec4 value) {
    imageStore(Detail, ivec3(texel, layer), value);
}

uint relativityCount(ivec2 at, uint n) {
    return 0u;
}
#else
vec2 relativityRayUv(ivec2 texel) {
    return vec2(texel) + 0.5;
}

void relativityStore(ivec2 texel, int layer, vec4 value) {
    imageStore(Table, ivec3(texel, layer), value);
}

uint relativityCount(ivec2 at, uint n) {
    return imageAtomicAdd(Counts, at, n);
}
#endif

const float STEP = 0.2;
const int LIMIT = 1500;

vec3 acceleration(vec3 x, vec3 v) {
    vec3 a = vec3(0.0);
    float speed2 = dot(v, v);
    vec3 u = v * inversesqrt(speed2);
    for (int k = 0; k < relativityFieldCount(); k += 1) {
        vec3 d = x - relativityFieldCentre(k);
        vec4 params = relativityFieldParams(k);
        if (relativityFieldHole(k)) {
            float r2 = dot(d, d);
            vec3 hv = cross(d, v);
            a += d * (-1.5 * params.x * dot(hv, hv) / (r2 * r2 * sqrt(r2)));
        } else {
            vec3 across = d - u * dot(d, u);
            float q = dot(d, d) + params.y * params.y;
            a += across * (-2.0 * params.x * speed2 / (q * sqrt(q)));
        }
    }
    return a;
}

// Tubes alone: the light walked through their walls (relativityTubeStep: straight between them),
// each straight stretch's crossings of the spheres solved exactly; no hole to capture it but a tube's horizon.
void tubeWalk(ivec2 texel, int shells) {
    vec3 d = relativityTableDirection(relativityRayUv(texel));
    vec3 x = vec3(0.0);
    vec3 p;
    float pt;
    int region;
    relativityTubeStart(x, d, p, pt, region);
    int k = 0;
    bool captured = false;
    vec3 w = d;
    for (int e = 0; e < relativityTubeEvents() && k < shells; e += 1) {
        vec3 a = x;
        w = normalize(relativityTubeVelocity(p, pt, region));
        int outcome = relativityTubeStep(x, p, pt, region);
        float len = 1e9;
        if (outcome != 1) len = length(x - a);
        // The spheres this stretch crosses going out (each the first time the light reaches it).
        while (k < shells) {
            float r = relativityTableRadius(float(k));
            float b = dot(a, w);
            float disc = b * b - (dot(a, a) - r * r);
            if (disc < 0.0) break;
            float t = -b + sqrt(disc);
            if (t < 0.0 || t > len) break;
            relativityStore(texel, 2 * k, vec4(a + w * t, 1.0));
            relativityStore(texel, 2 * k + 1, vec4(w, 0.0));
            relativityCount(ivec2(0, 0), 1u);
            k += 1;
        }
        if (outcome == -1) { captured = true; break; }
        if (outcome == 1) break;
    }
    for (int rest = k; rest < shells; rest += 1) {
        relativityStore(texel, 2 * rest, vec4(0.0));
        relativityStore(texel, 2 * rest + 1, vec4(0.0));
    }
    relativityStore(texel, 2 * shells, vec4(w, captured ? 0.0 : 1.0));
}

// The fields (lens_fields: every registered type's) instead, as one (lensFieldAt), the light followed by their
// Hamiltonian (midpoint steps in its own parameter, each as long as the field's safe step: SDF sphere tracing), its
// crossings of the spheres on each step's chord. ([122].w 4: VertexLens.fieldMarch.)
const int FIELD_LIMIT = 1500;
const float FIELD_MIN_STEP = 0.02;
const float FIELD_TOLERANCE = 2e-3; // blocks a step may stray (in a wall's band: lensFieldAdvanceAdaptive)

void fieldMarch(ivec2 texel, int shells) {
    vec3 d = relativityTableDirection(relativityRayUv(texel));
    vec3 x = vec3(0.0);
    LensFieldSample s = lensFieldAt(x);
    vec3 p = lensFieldStart(s, d);
    float far = RelativityLensData[6].w;
    int k = 0;
    vec3 w = d;
    float h = FIELD_MIN_STEP;
    int i = 0;
    bool rough = false;
    // (Whether it has been through a wall's band yet: there the table is coarse, and the lens finishes by tracing.)
    bool walled = false;
    for (i = 0; i < FIELD_LIMIT && k < shells; i += 1) {
        vec3 a = x;
        // (As far as the field lets it, and no farther than the farthest sphere.)
        if (s.safe <= FIELD_MIN_STEP) walled = true;
        if (!lensFieldAdvanceAdaptive(x, p, s, h, FIELD_MIN_STEP, far, FIELD_TOLERANCE)) rough = true;
        if (s.absorbed) break;
        vec3 next = x;
        w = normalize(next - a);
        vec3 seg = next - a;
        float len = length(seg);
        vec3 u = seg / max(len, 1e-9);
        while (k < shells) {
            float r = relativityTableRadius(float(k));
            float b = dot(a, u);
            float disc = b * b - (dot(a, a) - r * r);
            if (disc < 0.0) break;
            float t = -b + sqrt(disc);
            if (t < 0.0 || t > len) break;
            relativityStore(texel, 2 * k, vec4(a + u * t, 1.0));
            relativityStore(texel, 2 * k + 1, vec4(u, walled ? 1.0 : 0.0));
            relativityCount(ivec2(0, 0), 1u);
            k += 1;
        }
        if (length(x) > far * 1.01) break;
    }
    // TEMP: why rays stop short (Counts 249..254).
    if (rough) relativityCount(ivec2(249, 0), 1u);
    if (k >= shells) relativityCount(ivec2(254, 0), 1u);
    else if (s.absorbed) relativityCount(ivec2(250, 0), 1u);
    else if (i >= FIELD_LIMIT) relativityCount(ivec2(251, 0), 1u);
    else if (length(x) > far * 1.01) relativityCount(ivec2(252, 0), 1u);
    else relativityCount(ivec2(253, 0), 1u);
    if (k < shells) imageAtomicMax(Counts, ivec2(248, 0), uint(i));
    for (int rest = k; rest < shells; rest += 1) {
        relativityStore(texel, 2 * rest, vec4(0.0));
        relativityStore(texel, 2 * rest + 1, vec4(0.0));
    }
    relativityStore(texel, 2 * shells, vec4(w, s.absorbed ? 0.0 : 1.0));
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(relativityTableSize());
#ifdef LIGHT_TABLE_DETAIL
    if (relativityRaySlot(texel) < 0) return;
#else
    if (texel.x >= size.x || texel.y >= size.y) return;
#endif
    int shells = relativityTableShells();
    if (RelativityLensData[122].w > 3.5) {
        fieldMarch(texel, shells);
        return;
    }
    if (relativityFieldCount() == 0 && relativityTubeCount() > 0 && relativityBubbleCount() == 0) {
        tubeWalk(texel, shells);
        return;
    }
    float far = RelativityLensData[6].w;
    vec3 x = vec3(0.0);
    vec3 v = relativityTableDirection(relativityRayUv(texel));
    int k = 0;
    bool captured = false;
    for (int i = 0; i < LIMIT && k < shells; i += 1) {
        float nearest = far;
        for (int s = 0; s < relativityFieldCount(); s += 1) {
            vec3 d = x - relativityFieldCentre(s);
            float r = length(d);
            if (relativityFieldHole(s) && r <= 1.5 * relativityFieldParams(s).x && dot(d, v) < 0.0) captured = true;
            nearest = min(nearest, r);
        }
        if (captured) break;
        float h = clamp(STEP * nearest, 0.02, 0.1 * far);
        vec3 a1 = acceleration(x, v);
        vec3 v2 = v + a1 * (0.5 * h);
        vec3 a2 = acceleration(x + v * (0.5 * h), v2);
        vec3 v3 = v + a2 * (0.5 * h);
        vec3 a3 = acceleration(x + v2 * (0.5 * h), v3);
        vec3 v4 = v + a3 * h;
        vec3 a4 = acceleration(x + v3 * h, v4);
        vec3 next = x + (v + 2.0 * v2 + 2.0 * v3 + v4) * (h / 6.0);
        vec3 vNext = v + (a1 + 2.0 * a2 + 2.0 * a3 + a4) * (h / 6.0);
        // The spheres this step crosses going out (each the first time the light reaches it), linear within the step.
        while (k < shells && length(next) >= relativityTableRadius(float(k))) {
            float r = relativityTableRadius(float(k));
            float f = length(next) > length(x) ? clamp((r - length(x)) / (length(next) - length(x)), 0.0, 1.0) : 1.0;
            vec3 at = mix(x, next, f);
            relativityStore(texel, 2 * k, vec4(at, 1.0));
            relativityStore(texel, 2 * k + 1, vec4(normalize(next - x), 0.0));
            // (Tallied by signature: the commonest get the slots, light_table_pick.comp.)
            relativityCount(ivec2(int(relativityTableSignature(relativityTableDirection(relativityRayUv(texel)), at) & 255u), 0), 1u);
            k += 1;
        }
        x = next;
        v = vNext;
    }
    // (Light a hole captured: where it was last, on the first sphere it never reached, marked partial (w 0.5), so what
    // it passed on its way in, between the last sphere and there, is found: the thin arcs by a shadow's edge.
    // Spheres past that: none.)
    int rest = k;
    if (captured && k < shells) {
        relativityStore(texel, 2 * k, vec4(x, 0.5));
        relativityStore(texel, 2 * k + 1, vec4(normalize(v), 0.0));
        rest = k + 1;
    }
    for (; rest < shells; rest += 1) {
        relativityStore(texel, 2 * rest, vec4(0.0));
        relativityStore(texel, 2 * rest + 1, vec4(0.0));
    }
    relativityStore(texel, 2 * shells, vec4(normalize(v), captured ? 0.0 : 1.0));
}
