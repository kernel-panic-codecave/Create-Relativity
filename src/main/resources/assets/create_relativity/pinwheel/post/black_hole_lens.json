{
  "renderStage": "after_level",
  "framebuffers": {
    "kerr_table": {
      "autoClear": false,
      "width": "q.screen_width / 4",
      "height": "q.screen_height / 4",
      "color_buffers": [
        {
          "format": "RGBA32F"
        },
        {
          "format": "RGBA32F"
        },
        {
          "format": "RGBA32F"
        }
      ],
      "depth": false
    },
    "scene_table": {
      "autoClear": false,
      "width": "q.screen_width / 4",
      "height": "q.screen_height / 4",
      "format": "RGBA32F",
      "depth": false
    },
    "scene_refine": {
      "autoClear": false,
      "width": "q.screen_width / 2",
      "height": "q.screen_height / 2",
      "format": "RGBA32F",
      "depth": true
    },
    "sky_probe": {
      "width": "256",
      "height": "128",
      "format": "RGBA16F",
      "depth": false,
      "autoClear": false
    }
  },
  "textures": {
    "KerrTable0": {
      "type": "framebuffer",
      "name": "kerr_table",
      "sampler": 0
    },
    "KerrTable1": {
      "type": "framebuffer",
      "name": "kerr_table",
      "sampler": 1
    },
    "KerrTable2": {
      "type": "framebuffer",
      "name": "kerr_table",
      "sampler": 2
    },
    "SceneTable": {
      "type": "framebuffer",
      "name": "scene_table",
      "sampler": 0
    },
    "SceneTable2": {
      "type": "framebuffer",
      "name": "scene_refine",
      "sampler": 0
    },
    "SkyProbe": {
      "type": "framebuffer",
      "name": "sky_probe",
      "sampler": 0
    }
  },
  "stages": [
    {
      "type": "veil:blit",
      "shader": "create_relativity:sky_probe",
      "in": "minecraft:main",
      "out": "sky_probe"
    },
    {
      "type": "create_relativity:cached_blit",
      "shader": "create_relativity:kerr_table",
      "out": "kerr_table"
    },
    {
      "type": "create_relativity:cached_blit",
      "shader": "create_relativity:scene_table",
      "in": "minecraft:main",
      "out": "scene_table"
    },
    {
      "type": "create_relativity:sparse_march",
      "mark": "create_relativity:scene_refine",
      "march": "create_relativity:scene_refine_march",
      "in": "minecraft:main",
      "out": "scene_refine"
    },
    {
      "type": "veil:blit",
      "shader": "create_relativity:black_hole_lens",
      "in": "minecraft:main"
    }
  ]
}